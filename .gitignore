out/
node_modules/
package-lock.json
package.json

# ELS 수집 실패 시에만 남는 진단자료 — 저장소에 들어갈 이유가 없다
/discovery/
collect-debug/

# 파이썬 바이트코드 — 저장소에 들어갈 이유가 없다
__pycache__/
*.pyc

# 한국투자증권 오픈API 앱키와 접근토큰. **저장소에 들어가면 안 된다.**
# 접근토큰은 24시간 유효한데 발급이 1분 1회로 막혀 있어 파일에 캐싱해 쓴다
# (scripts/kis_lib.py). 그 캐시가 여기 걸린다.
.kis-token.json
.kis-token.json.tmp
.env
.env.*

# 빈칸 검증에서 나오는 임시물 — 쪽 그림과 집계표. 저장소에 남기지 않는다.
# 8/19 판을 만들 때 실제로 2.2MB 가 저장소 뿌리에 쌓였다.
pg/
g.txt
out-beta/
out-prod/

# 오프라인 판(데이터를 심은 판)은 만들 때마다 300KB 가 통째로 바뀐다. 필요하면
# `python scripts/inline_calendar.py` 로 다시 만들면 되므로 저장소에 남기지 않는다.
market-calendar-offline.html

# 목록 점검 결과는 데이터 브랜치(us100-data)가 원본이다. 여기 받아 두는 것은 사본일 뿐.
data/us100/ranking.json

# 변동성 경보 한 파일 판(자료를 심은 판) — 만들 때마다 0.3MB 가 통째로 바뀐다.
# `python3 scripts/make_volatility_offline.py` 로 다시 만들면 되므로 남기지 않는다.
volatility-offline.html

# 매매 신호 한 파일 판 — 201종목을 심어 4.4MB 다. 날마다 통째로 바뀌므로 저장소에
# 쌓으면 안 된다. `python3 scripts/make_signal_offline.py` 로 다시 만든다.
signal-offline.html

# 고객용 한 장(자료를 심은 판) — `python3 scripts/build_client_page.py` 로 다시 만든다.
volatility-client.html
etf-offline.html

# PPT 를 만들 때 파이썬이 노드에 넘기는 중간 파일. 만들자마자 지우지만
# 중간에 죽으면 남는다.
.proposal-deck.json
.proposal-smoke.mjs
