{
  "_설명": [
    "부서 자료실의 분류 정의입니다. 이 파일이 있으면 '_목록갱신.py' 가 설정 모드로 돌아갑니다.",
    "파일을 복사하지 않고 원래 자리에 둔 채 목록에만 모으므로, 자동화가 새 브리핑을",
    "만들면 목록 갱신만으로 바로 반영됩니다.",
    "",
    "path        : 자료실.html 기준 상대 경로",
    "include     : 포함할 파일 패턴 (예: *.html)",
    "exclude     : 그중 뺄 파일 패턴",
    "files       : 파일을 콕 집어 넣을 때. title 로 표시 이름을 바꿀 수 있습니다",
    "rename      : [정규식, 치환문자열] 목록. 파일명을 읽기 좋은 제목으로 바꿉니다",
    "date_from_name : 파일명에서 날짜를 뽑아 '수정일' 로 씁니다.",
    "                 git 으로 내려받으면 파일 날짜가 전부 내려받은 시각이 되므로,",
    "                 날짜가 이름에 있는 자료는 이 값을 쓰는 편이 정확합니다."
  ],

  "categories": [
    {
      "name": "시장 브리핑",
      "desc": "일자별 모닝·장마감·해외 증시 브리핑 보관본",
      "sources": [
        {
          "path": "../docs/briefings",
          "include": ["*.html"],
          "date_from_name": "(\\d{4}-\\d{2}-\\d{2})",
          "rename": [
            ["^(\\d{4}-\\d{2}-\\d{2})-morning$", "\\1 모닝 마켓 브리핑"],
            ["^(\\d{4}-\\d{2}-\\d{2})-close$", "\\1 장마감 시황 브리핑"],
            ["^(\\d{4}-\\d{2}-\\d{2})-global$", "\\1 해외 증시 브리핑"]
          ]
        }
      ]
    },
    {
      "name": "종목 대시보드",
      "desc": "종목코드를 넣으면 시세·투자의견·재무·뉴스를 한 장으로 보여주는 화면",
      "sources": [
        {
          "path": "..",
          "files": [
            {
              "name": "standalone.html",
              "title": "종목 통합 리포트 대시보드 (단독 실행본)"
            }
          ]
        }
      ]
    },
    {
      "name": "업무 가이드",
      "desc": "브리핑 제작 기준과 도구 사용법",
      "sources": [
        {
          "path": "../docs",
          "files": [
            { "name": "briefing-playbook.md", "title": "브리핑 제작 플레이북" }
          ]
        },
        {
          "path": "..",
          "files": [
            { "name": "README.md", "title": "종목 대시보드 사용 설명서" }
          ]
        },
        {
          "path": ".",
          "files": [
            { "name": "README.md", "title": "부서 자료실 사용 설명서" }
          ]
        }
      ]
    },
    {
      "name": "시장 데이터",
      "desc": "자동 수집한 일자별 시세 원본 (JSON)",
      "sources": [
        {
          "path": "../data/market",
          "files": [
            { "name": "latest.json", "title": "최신 시세 수집본 (자동 갱신)" }
          ]
        },
        {
          "path": "../data/market",
          "include": ["*.json"],
          "exclude": ["latest.json"],
          "date_from_name": "(\\d{4}-\\d{2}-\\d{2})",
          "rename": [
            ["^(\\d{4}-\\d{2}-\\d{2})$", "\\1 시세 수집본"]
          ]
        }
      ]
    },
    {
      "name": "제작 소스",
      "desc": "브리핑·대시보드를 만드는 스크립트와 원본 파일",
      "sources": [
        {
          "path": "../scripts",
          "include": ["*.py", "*.sh", "*.mjs"]
        },
        {
          "path": "..",
          "files": [
            { "name": "index.html", "title": "대시보드 원본 (분리 파일 버전)" }
          ]
        },
        {
          "path": "../data",
          "include": ["*.js"]
        }
      ]
    }
  ]
}
